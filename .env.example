# Optional: live multimodal menu extraction. Without it, TasteDNA uses demo fallbacks.
OPENAI_API_KEY=
OPENAI_MENU_MODEL=gpt-5.6-luna
OPENAI_MENU_FALLBACK_MODEL=gpt-5.6-terra
OPENAI_MENU_TIMEOUT_MS=30000

# Optional: persisted accounts, profiles, and shared venue cache.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server routes may use a non-public URL when available.
SUPABASE_URL=
# Server only. Never expose this value through a NEXT_PUBLIC_ variable.
SUPABASE_SECRET_KEY=

# Optional: CMU Dining sync. Ordinary venue reads never call the upstream API.
CMU_DINING_API_URL=https://api.cmueats.com/v2/locations
CMU_DINING_TIMEOUT_MS=8000
CMU_DINING_SYNC_SECRET=

# Set to true to force sample extraction even when an OpenAI key exists.
TASTEDNA_DEMO_MODE=false
