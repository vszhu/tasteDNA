# Optional: live multimodal menu extraction. Without it, TasteDNA uses demo fallbacks.
OPENAI_API_KEY=
OPENAI_MENU_MODEL=gpt-5-mini

# Optional: persisted accounts and profiles. Local storage is used when unset.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Set to true to force sample extraction even when an OpenAI key exists.
TASTEDNA_DEMO_MODE=false
